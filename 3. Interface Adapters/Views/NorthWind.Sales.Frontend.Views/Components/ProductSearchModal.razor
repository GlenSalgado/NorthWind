@namespace NorthWind.Sales.Frontend.Views.Components
@using NorthWind.Sales.Entities.Dtos.Pagination
@using NorthWind.Sales.Entities.Dtos.Products
@using NorthWind.Sales.Frontend.BusinessObjects.Interfaces
@inject IProductGateway ProductGateway

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px);" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header bg-primary text-white px-4 py-3">
                    <h5 class="modal-title fw-bold mb-0">
                        @(IsReplaceMode ? "Actualizar Producto" : "Búsqueda de Productos")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Search Input Box -->
                    <div class="row g-2 mb-3 align-items-center">
                        <div class="col-md-3">
                            <select class="form-select" @bind="SearchBy" @bind:after="SearchCriteriaChanged" aria-label="Buscar productos por">
                                <option value="all">Todas</option>
                                <option value="id">ID</option>
                                <option value="name">Nombre</option>
                                <option value="stock">Stock</option>
                                <option value="price">Precio</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group">
                                <input type="@(SearchBy is "id" or "stock" or "price" ? "number" : "text")"
                                       class="form-control"
                                       step="@(SearchBy == "price" ? "0.01" : null)"
                                       placeholder="@(SearchBy == "all" ? "Buscar por nombre o ID..." : $"Buscar por {SearchBy}...")"
                                       @bind="SearchText"
                                       @bind:event="oninput"
                                       @onkeyup="OnSearchKeyUp" />
                                @if (!string.IsNullOrEmpty(SearchText))
                                {
                                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">Limpiar</button>
                                }
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary w-100 fw-semibold" type="button" @onclick="() => LoadProducts(1)">
                                Buscar
                            </button>
                        </div>
                    </div>

                    <!-- Loading Indicator -->
                    @if (IsLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" style="width: 2.5rem; height: 2.5rem;" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="text-muted mt-2 fw-medium">Consultando catálogo de productos...</p>
                        </div>
                    }
                    else if (ProductsPage == null || ProductsPage.Items.Count == 0)
                    {
                        <div class="alert alert-secondary text-center py-4 rounded-3 border-0 shadow-sm">
                            <h6 class="fw-bold mb-1">No se encontraron productos disponibles</h6>
                            <p class="mb-0 text-muted">No existen productos que coincidan con la búsqueda.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive rounded-3 border">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3" style="width: 15%;">ID</th>
                                        <th style="width: 40%;">Nombre del Producto</th>
                                        <th class="text-center" style="width: 20%;">Stock Disponible</th>
                                        <th class="text-end" style="width: 15%;">Precio</th>
                                        <th class="text-center pe-3" style="width: 10%;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in ProductsPage.Items)
                                    {
                                        bool isAlreadyAdded = !IsReplaceMode && ExcludedProductIds.Contains(product.Id);
                                        bool isCurrentItem = IsReplaceMode && CurrentEditingProductId == product.Id;

                                        <tr class="@(isAlreadyAdded ? "table-light text-muted opacity-75" : "")">
                                            <td class="ps-3">
                                                <span class="badge bg-secondary font-monospace px-2 py-1">#@product.Id</span>
                                            </td>
                                            <td class="fw-medium">
                                                @product.Name
                                                @if (isAlreadyAdded)
                                                {
                                                    <span class="badge bg-warning text-dark ms-2">Ya agregado</span>
                                                }
                                                @if (isCurrentItem)
                                                {
                                                    <span class="badge bg-info text-dark ms-2">Producto actual</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border px-2 py-1">
                                                    @product.UnitsInStock unidades
                                                </span>
                                            </td>
                                            <td class="text-end font-monospace fw-semibold text-dark">
                                                @product.UnitPrice.ToString("N2")
                                            </td>
                                            <td class="text-center pe-3">
                                                @if (isAlreadyAdded)
                                                {
                                                    <button type="button" class="btn btn-sm btn-secondary px-3" disabled>
                                                        Duplicado
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-primary px-3 fw-semibold shadow-sm"
                                                            @onclick="() => SelectProduct(product)">
                                                        @(IsReplaceMode ? "Actualizar" : "Agregar")
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 pt-2 border-top">
                            <div class="text-muted small">
                                Mostrando <strong>@ProductsPage.Items.Count</strong> de <strong>@ProductsPage.TotalItems</strong> productos
                                (Pág. @ProductsPage.PageNumber de @ProductsPage.TotalPages)
                            </div>

                            <nav aria-label="Paginación">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(ProductsPage.HasPreviousPage ? "" : "disabled")">
                                        <button class="page-link" @onclick="() => LoadProducts(ProductsPage.PageNumber - 1)">
                                            Anterior
                                        </button>
                                    </li>

                                    @for (int p = 1; p <= ProductsPage.TotalPages; p++)
                                    {
                                        var pageIndex = p;
                                        <li class="page-item @(pageIndex == ProductsPage.PageNumber ? "active" : "")">
                                            <button class="page-link" @onclick="() => LoadProducts(pageIndex)">
                                                @pageIndex
                                            </button>
                                        </li>
                                    }

                                    <li class="page-item @(ProductsPage.HasNextPage ? "" : "disabled")">
                                        <button class="page-link" @onclick="() => LoadProducts(ProductsPage.PageNumber + 1)">
                                            Siguiente
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary px-4 fw-medium" @onclick="CloseModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback<ProductDto> OnProductSelected { get; set; }
    [Parameter] public List<int> ExcludedProductIds { get; set; } = [];
    [Parameter] public bool IsReplaceMode { get; set; }
    [Parameter] public int? CurrentEditingProductId { get; set; }

    string SearchText = string.Empty;
    string SearchBy = "all";
    bool IsLoading = false;
    PagedResult<ProductDto>? ProductsPage;
    int CurrentPage = 1;
    const int PageSize = 5;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && ProductsPage == null)
        {
            await LoadProducts(1);
        }
    }

    async Task LoadProducts(int page)
    {
        CurrentPage = page;
        IsLoading = true;
        try
        {
            ProductsPage = await ProductGateway.SearchProductsAsync(SearchText, SearchBy, CurrentPage, PageSize);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar productos: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadProducts(1);
        }
    }

    async Task ClearSearch()
    {
        SearchText = string.Empty;
        await LoadProducts(1);
    }

    async Task SearchCriteriaChanged()
    {
        SearchText = string.Empty;
        await LoadProducts(1);
    }

    async Task SelectProduct(ProductDto product)
    {
        await OnProductSelected.InvokeAsync(product);
        await CloseModal();
    }

    async Task CloseModal()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }
}
